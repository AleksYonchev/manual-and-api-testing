  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{test_username}}\",\n  \"firstName\": \"QA\",\n  \"lastName\": \"Portfolio\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"rePassword\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/User/Register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "User",
            "Register"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is successful (2xx)\", function () {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "",
              "pm.test(\"Response time is under 3000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "if (pm.response.text().trim().length > 0) {",
              "    pm.test(\"Response body is valid JSON when a body is returned\", function () {",
              "        pm.expect(() => pm.response.json()).to.not.throw();",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
